# Fresh Spindle production account host behind https://spindle.berlayar.ai (see deploy/README.md).
# User unit. Install: cp to ~/.config/systemd/user/, then `systemctl --user daemon-reload` and
# `systemctl --user start spindle-production`. Deliberately not enabled at boot by this file.
# Separate from the protected private 43166 instance: own release checkout, data dir, key and port.
[Unit]
Description=Spindle production account host (127.0.0.1:43180, public via Worker + Workers VPC)
After=network-online.target

[Service]
Type=simple
# Release checkout built at the exact product-integrator release head (worktree of the canonical clone).
WorkingDirectory=%h/code/erniesg/spindle-release
ExecStart=/usr/bin/node build/core/preparation/startup.js --application-module %h/.config/spindle/production/account-config.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
