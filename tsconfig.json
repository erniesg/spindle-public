{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "build",
    "types": ["node", "chrome"]
  },
  "include": ["core/**/*.ts", "browser-extension/**/*.ts", "tools/**/*.ts", "tests/**/*.ts", "examples/**/*.ts"]
}
